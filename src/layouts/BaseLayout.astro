---
import { SITE } from '../config';
import { products } from '../data/products';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.brandName} · Joias em Prata 925`,
  description = SITE.tagline,
} = Astro.props;

// SEO: dados estruturados da loja
const storeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: SITE.brandName,
  description: SITE.tagline,
  url: SITE.url,
};

// SEO: dados estruturados dos produtos (rich snippets)
const productsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${SITE.brandName} - Catálogo de Joias em Prata 925`,
  description: SITE.tagline,
  url: SITE.url,
  itemListElement: products.map((product, index) => ({
    '@type': 'Product',
    position: index + 1,
    name: product.name,
    description: product.description,
    image: `${SITE.url}${product.image}`,
    offers: {
      '@type': 'Offer',
      price: product.price,
      priceCurrency: 'BRL',
      availability: 'https://schema.org/InStock',
    },
    category: product.category,
  })),
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.brandName} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={SITE.url} />

    <!-- Open Graph (compartilhamento em redes sociais) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={SITE.url} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.brandName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.svg" />
    <meta name="twitter:domain" content={SITE.url} />

    <!-- Fontes: títulos elegantes (Playfair Display) + texto (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Preload de fontes críticas -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" as="style" />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" as="style" />

    <!-- Dados estruturados da loja -->
    <script type="application/ld+json" set:html={JSON.stringify(storeJsonLd)} />

    <!-- Dados estruturados dos produtos -->
    <script type="application/ld+json" set:html={JSON.stringify(productsJsonLd)} />

    <!-- Estilos para acessibilidade e focus states -->
    <style is:global>
      /* Melhorar visibilidade de focus para navegação por teclado */
      *:focus-visible {
        outline: 2px solid #D4AF37;
        outline-offset: 2px;
      }

      /* Smooth scroll */
      html {
        scroll-behavior: smooth;
      }

      /* Ocultar scrollbar horizontal mas manter funcionalidade */
      body {
        overflow-x: hidden;
      }

      /* Melhorar contraste de texto */
      .text-silver\/50 {
        color: rgba(229, 228, 226, 0.6);
      }

      .text-silver\/40 {
        color: rgba(229, 228, 226, 0.5);
      }

      .text-silver\/70 {
        color: rgba(229, 228, 226, 0.8);
      }
    </style>
  </head>
  <body class="bg-ink text-silver font-sans antialiased selection:bg-accent/40">
    <slot />
  </body>
</html>
