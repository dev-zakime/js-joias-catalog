---
import { SITE } from '../config';
---

<!-- Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 bg-ink/80 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"
></div>

<!-- Menu lateral -->
<aside
  id="mobile-menu"
  class="fixed inset-y-0 right-0 z-50 w-72 bg-ink-900 border-l border-white/10 transform translate-x-full transition-transform duration-300 ease-out"
>
  <div class="flex flex-col h-full">
    <!-- Header do menu -->
    <div class="flex items-center justify-between p-6 border-b border-white/10">
      <span class="font-display text-2xl tracking-wider text-silver">
        {SITE.brandName}
      </span>
      <button
        id="mobile-menu-close"
        type="button"
        class="p-2 rounded-lg text-silver/70 hover:text-silver hover:bg-white/10 transition-colors"
        aria-label="Fechar menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Links de navegação -->
    <nav class="flex-1 p-6 space-y-4">
    </nav>
  </div>
</aside>

<script>
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link');

  function openMenu() {
    mobileMenu.classList.remove('translate-x-full');
    mobileMenuBackdrop.classList.remove('hidden');
    requestAnimationFrame(() => {
      mobileMenuBackdrop.classList.remove('opacity-0');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu.classList.add('translate-x-full');
    mobileMenuBackdrop.classList.add('opacity-0');
    setTimeout(() => {
      mobileMenuBackdrop.classList.add('hidden');
    }, 300);
    document.body.style.overflow = '';
  }

  // Expor função globalmente para o botão do header
  (window as any).openMobileMenu = openMenu;

  mobileMenuClose?.addEventListener('click', closeMenu);
  mobileMenuBackdrop?.addEventListener('click', closeMenu);
  mobileMenuLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu.classList.contains('translate-x-full')) {
      closeMenu();
    }
  });
</script>
