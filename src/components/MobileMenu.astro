---
import { SITE, getWhatsappLinkGenerico } from '../config';

const whatsappLink = getWhatsappLinkGenerico();
---

<!-- Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 bg-ink/80 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"
></div>

<!-- Menu lateral -->
<aside
  id="mobile-menu"
  class="fixed inset-y-0 right-0 z-50 w-72 bg-ink-900 border-l border-white/10 transform translate-x-full transition-transform duration-300 ease-out"
>
  <div class="flex flex-col h-full">
    <!-- Header do menu -->
    <div class="flex items-center justify-between p-6 border-b border-white/10">
      <span class="font-display text-2xl tracking-wider text-silver">
        {SITE.brandName}
      </span>
      <button
        id="mobile-menu-close"
        type="button"
        class="p-2 rounded-lg text-silver/70 hover:text-silver hover:bg-white/10 transition-colors"
        aria-label="Fechar menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Links de navegação -->
    <nav class="flex-1 p-6 space-y-4">
    </nav>

    <!-- CTA WhatsApp -->
    <div class="p-6 border-t border-white/10">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-menu-link flex items-center justify-center gap-2 w-full rounded-full bg-gold px-6 py-3 text-base font-semibold text-white hover:bg-gold-dark hover:shadow-[0_0_25px_var(--tw-shadow-gold-glow)] transition-all"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        Comprar no WhatsApp
      </a>
    </div>
  </div>
</aside>

<script>
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link');

  function openMenu() {
    mobileMenu.classList.remove('translate-x-full');
    mobileMenuBackdrop.classList.remove('hidden');
    requestAnimationFrame(() => {
      mobileMenuBackdrop.classList.remove('opacity-0');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu.classList.add('translate-x-full');
    mobileMenuBackdrop.classList.add('opacity-0');
    setTimeout(() => {
      mobileMenuBackdrop.classList.add('hidden');
    }, 300);
    document.body.style.overflow = '';
  }

  // Expor função globalmente para o botão do header
  (window as any).openMobileMenu = openMenu;

  mobileMenuClose?.addEventListener('click', closeMenu);
  mobileMenuBackdrop?.addEventListener('click', closeMenu);
  mobileMenuLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu.classList.contains('translate-x-full')) {
      closeMenu();
    }
  });
</script>
