---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Formata preço em R$ (padrão brasileiro)
const precoFormatado = product.price.toLocaleString('pt-BR', {
  style: 'currency',
  currency: 'BRL',
});
---

<article
  data-category={product.category}
  data-slug={product.slug}
  data-name={product.name}
  data-price={precoFormatado}
  data-image={product.image}
  data-description={product.description}
  data-details={JSON.stringify(product.details)}
  class="product-card group relative cursor-pointer overflow-hidden rounded-2xl border border-white/10 bg-ink-800 transition-all duration-300 hover:border-gold/50 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(212,175,55,0.3)]"
>
  <!-- Imagem -->
  <div class="relative aspect-square overflow-hidden bg-gradient-to-br from-ink-700 to-ink-900">
    <img
      src={product.image}
      alt={product.name}
      loading="lazy"
      width="500"
      height="500"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
    <!-- Badge 925 -->
    <span class="absolute top-3 left-3 rounded-full bg-ink/80 backdrop-blur px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-gold transition-transform duration-300 group-hover:scale-110">
      Prata 925
    </span>
    {product.featured && (
      <span class="absolute top-3 right-3 rounded-full bg-gold px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white animate-pulse-glow">
        ★ Destaque
      </span>
    )}
    <!-- Overlay gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>

  <!-- Informações -->
  <div class="p-4 sm:p-5">
    <h3 class="font-semibold text-silver group-hover:text-gold transition-colors duration-300 truncate">
      {product.name}
    </h3>
    <p class="mt-1 text-sm text-silver/50 line-clamp-2 group-hover:text-silver/70 transition-colors duration-300">{product.description}</p>
    <div class="mt-3 flex items-center justify-between">
      <span class="text-lg font-bold text-silver group-hover:text-gold transition-colors duration-300">{precoFormatado}</span>
      <span class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-gold group-hover:translate-x-1 transition-transform duration-300">
        Ver
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Overlay de clique -->
  <button
    type="button"
    class="absolute inset-0 z-10 focus:outline-none"
    aria-label={`Ver detalhes de ${product.name}`}
  ></button>
</article>
