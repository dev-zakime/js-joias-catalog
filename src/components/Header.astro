---
import { SITE } from '../config';
---

<header
  class="fixed top-0 inset-x-0 z-40 backdrop-blur-md bg-ink/80 border-b border-white/5"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-center h-16 md:h-20">
      <!-- Logo centralizado -->
      <a href="#topo" class="group flex items-center gap-2">
        <span
          class="font-display text-2xl md:text-3xl tracking-wider text-silver group-hover:text-gold transition-colors duration-300"
        >
          {SITE.brandName}
        </span>
        <span class="text-[10px] uppercase tracking-[0.25em] text-silver/50 -mt-3 hidden sm:block group-hover:text-gold/70 transition-colors duration-300">
          Prata 925
        </span>
      </a>
    </div>
  </div>
</header>
