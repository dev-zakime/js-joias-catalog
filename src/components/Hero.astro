---
import { SITE } from '../config';
---

<section
  id="topo"
  class="relative bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 overflow-hidden pt-16 sm:pt-20 pb-12 sm:pb-16"
>
  <!-- Fundo: gradientes elegantes -->
  <div class="absolute inset-0 -z-10">
    <!-- Manchas de luz douradas -->
    <div class="absolute top-1/4 -left-20 w-96 h-96 bg-gold/20 rounded-full blur-[120px] animate-pulse-glow"></div>
    <div class="absolute bottom-1/4 -right-20 w-96 h-96 bg-gold/10 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-3 sm:px-4 md:px-6 lg:px-8 w-full">
    <div class="text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-gold/40 bg-gold/10 px-3 py-1 sm:px-4 sm:py-1.5 mb-4 sm:mb-6">
        <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
        <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-widest text-gold-light">Prata 925 · Alta Qualidade</span>
      </div>

      <!-- Título -->
      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-tight tracking-tight text-silver mb-4 sm:mb-6">
        Joias de <span class="text-gold">Prata 925</span>
      </h1>

      <!-- Subtítulo -->
      <p class="text-sm sm:text-base md:text-lg text-silver/60 max-w-2xl mx-auto leading-relaxed mb-4 sm:mb-6">
        Joias feitas com qualidade e carinho. Peças que combinam com você e duram muito tempo.
      </p>

      <!-- Formas de pagamento -->
      <div class="flex flex-wrap justify-center gap-2 sm:gap-3 text-xs sm:text-sm text-silver/50 mb-6 sm:mb-8">
        <span class="flex items-center gap-1.5 bg-ink/50 px-3 py-1.5 rounded-full">
          <svg class="w-3 h-3 sm:w-4 sm:h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          PIX 5% OFF
        </span>
        <span class="flex items-center gap-1.5 bg-ink/50 px-3 py-1.5 rounded-full">
          <svg class="w-3 h-3 sm:w-4 sm:h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
          6x sem juros
        </span>
      </div>

      <!-- Badges de confiança -->
      <div class="flex flex-wrap justify-center gap-3 sm:gap-4 text-xs sm:text-sm text-silver/50 mb-6 sm:mb-8">
        <span class="flex items-center gap-2 bg-ink/50 px-3 py-1.5 rounded-full">
          <svg class="w-3 h-3 sm:w-4 sm:h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          Prata 925 Legítima
        </span>
        <span class="flex items-center gap-2 bg-ink/50 px-3 py-1.5 rounded-full">
          <svg class="w-3 h-3 sm:w-4 sm:h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Hipossalergênica
        </span>
        <span class="flex items-center gap-2 bg-ink/50 px-3 py-1.5 rounded-full">
          <svg class="w-3 h-3 sm:w-4 sm:h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          Envio em 48h
        </span>
      </div>

      <!-- CTA -->
      <a
        href="#colecao"
        class="inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 sm:px-8 sm:py-4 text-sm sm:text-base font-bold uppercase tracking-wide text-white hover:bg-gold-dark hover:shadow-[0_0_30px_var(--tw-shadow-gold-glow)] transition-all duration-300 hover:scale-105 active:scale-95"
      >
        Ver Produtos
        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
