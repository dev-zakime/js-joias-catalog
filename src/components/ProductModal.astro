---
// Modal de detalhes do produto. Começa escondido e é preenchido via JS puro.
---

<div
  id="product-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 opacity-0 transition-opacity duration-300"
>
  <!-- Backdrop -->
  <div id="modal-backdrop" class="absolute inset-0 bg-ink/90 backdrop-blur-sm"></div>

  <!-- Conteúdo -->
  <div
    id="modal-content"
    class="relative z-10 w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-3xl border border-white/10 bg-ink-800 shadow-2xl animate-slide-up"
  >
    <!-- Botão fechar -->
    <button
      id="modal-close"
      type="button"
      aria-label="Fechar"
      class="absolute top-4 right-4 z-20 inline-flex h-10 w-10 items-center justify-center rounded-full bg-ink/80 backdrop-blur border border-white/10 text-silver hover:bg-accent hover:text-white transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="grid md:grid-cols-2 gap-0">
      <!-- Imagem -->
      <div class="relative aspect-square md:aspect-auto bg-gradient-to-br from-ink-700 to-ink-900 md:rounded-l-3xl overflow-hidden group max-h-[70vh] sm:max-h-[35vh] md:max-h-[85vh]">
        <img
          id="modal-image"
          src=""
          alt=""
          class="h-full w-full object-cover transition-transform duration-300 cursor-zoom-in"
          style="transform-origin: center center;"
        />
        <span class="absolute top-3 left-3 rounded-full bg-ink/80 backdrop-blur px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-gold z-10">
          Prata 925
        </span>
        <!-- Botão de zoom -->
        <button
          id="modal-zoom-btn"
          type="button"
          class="absolute bottom-4 right-4 z-10 p-2 rounded-full bg-ink/80 backdrop-blur border border-white/10 text-silver hover:bg-gold hover:text-white transition-colors"
          aria-label="Zoom"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
          </svg>
        </button>
        <!-- Indicador de zoom -->
        <div id="zoom-hint" class="absolute inset-0 flex items-center justify-center bg-ink/50 opacity-0 pointer-events-none transition-opacity duration-300">
          <span class="text-silver text-sm font-medium">Clique para ampliar</span>
        </div>
      </div>

      <!-- Detalhes -->
      <div class="flex flex-col p-4 sm:p-6 md:p-8">
        <h2 id="modal-title" class="font-display text-2xl sm:text-3xl md:text-4xl text-silver"></h2>
        <p id="modal-price" class="mt-2 text-xl sm:text-2xl font-bold text-accent-light"></p>

        <p id="modal-description" class="mt-3 sm:mt-4 text-sm sm:text-base text-silver/60 leading-relaxed"></p>

        <!-- Lista de detalhes -->
        <ul id="modal-details" class="mt-4 sm:mt-6 space-y-2 text-sm"></ul>

        <!-- Opções de pagamento -->
        <div class="mt-4 sm:mt-6 p-3 sm:p-4 rounded-xl bg-ink-700/50 border border-white/10">
          <h3 class="text-xs sm:text-sm font-semibold text-silver mb-2 sm:mb-3">Formas de pagamento</h3>
          <div class="space-y-1.5 sm:space-y-2 text-xs sm:text-sm">
            <div class="flex items-center gap-2 text-silver/80">
              <svg class="w-3 h-3 sm:w-4 sm:h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>PIX à vista com 5% de desconto</span>
            </div>
            <div class="flex items-center gap-2 text-silver/80">
              <svg class="w-3 h-3 sm:w-4 sm:h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Cartão em até 6x sem juros</span>
            </div>
          </div>
        </div>

        <!-- CTA WhatsApp -->
        <a
          id="modal-whatsapp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 sm:mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-gold px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base font-bold uppercase tracking-wide text-white hover:bg-gold-dark hover:shadow-[0_0_30px_var(--tw-shadow-gold-glow)] transition-all"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Comprar pelo WhatsApp
        </a>

        <p class="mt-2 sm:mt-3 text-center text-[10px] sm:text-xs text-silver/40">
          Responde rápido. Tire suas dúvidas antes de comprar.
        </p>
      </div>
    </div>
  </div>
</div>
