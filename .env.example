# Dados sensíveis - não comite este arquivo no repositório
# Copie este arquivo para .env.local e preencha com seus dados reais

# Número do WhatsApp (formato: código país + DDD + número, sem espaços)
# Exemplo: 5511999998888 (Brasil, DDD 11, número 99999-8888)
WHATSAPP_NUMBER=5511999998888

# Nome da marca
BRAND_NAME=JS

# URL do site (para SEO e compartilhamento)
SITE_URL=https://sua-marca.com.br